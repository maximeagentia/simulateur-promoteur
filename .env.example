# Variables d'environnement Vercel — à configurer sur le projet, pas dans ce fichier.

# Requis pour activer le lookup PLU réel (api/plu.js) et le pipeline
# d'extraction (api/cron/extract-plu.js). Sans ces deux-là, tout le code
# reste en repli sur le comportement existant (table statique ZONES_PLU).
#
# Projet Supabase "estimationterrain" déjà créé (org maximeagentia, région
# eu-west-3 Paris, palier gratuit) et les 4 migrations déjà appliquées.
# SUPABASE_URL ci-dessous, pas un secret. La clé service_role, elle, ne
# peut pas être récupérée par un outil automatisé (volontairement, côté
# Supabase) — à copier soi-même : dashboard Supabase > ce projet >
# Project Settings > API > "service_role" (pas "anon", pas "publishable").
SUPABASE_URL=https://iztsztirfzwxhmtucvam.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Requis pour que le cron d'extraction fonctionne réellement (sans elle,
# extraireReglesZone renvoie null et rien n'est extrait).
ANTHROPIC_API_KEY=

# Optionnel — modèle utilisé pour l'extraction PLU (défaut : claude-haiku-4-5,
# choisi pour un coût quasi nul ; passer à un modèle plus capable si la
# précision d'extraction s'avère insuffisante sur des règlements complexes).
PLU_EXTRACTION_MODEL=

# Optionnel — protège /api/cron/extract-plu contre les appels publics
# (chaque exécution déclenche des appels IGN/GeoPortail et potentiellement
# Anthropic). Vercel l'envoie automatiquement en Authorization: Bearer sur
# les invocations cron dès que cette variable est définie.
CRON_SECRET=

# Optionnel — nombre de communes traitées par passage du cron (défaut 2)
# et nombre max de zones extraites par commune par passage (défaut 10).
PLU_CRON_BATCH=
PLU_CRON_MAX_ZONES=

# Requis pour que l'écriture des leads dans Airtable (api/airtable.js)
# fonctionne — sans elle, l'endpoint répond ok en no-op (Supabase, lui,
# continue d'écrire normalement). Sert aussi, optionnellement, à activer la
# priorisation par vrai trafic (api/_lib/plu-communes-cibles.js) plutôt que
# la liste statique de repli.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
